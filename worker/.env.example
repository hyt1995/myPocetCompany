# 이 파일을 복사해서 .env 를 만들고 값을 채운다:  cp .env.example .env
# .env 는 GitHub에 올라가지 않는다. (키를 코드에 직접 쓰지 않는다)

# ---- Firebase (Vercel 환경변수와 같은 값) ----
FIREBASE_API_KEY=
FIREBASE_APPID=
FIREBASE_PROJECT_ID=focus-app-76679

# ---- 실전 주문 서명키 (Vercel 의 COMMAND_SIGNING_SECRET 과 똑같은 값) ----
# 만들기: openssl rand -hex 32
COMMAND_SIGNING_SECRET=

# ---- 바이낸스 (현물) ----
# 모의매매만 할 때는 비워 둬도 된다. (시세는 키 없이 받는다)
# 테스트넷 키: https://testnet.binance.vision 에서 발급 (가짜 돈)
# 실전 키: 출금 권한 OFF, 집 공인 IP 등록
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# ---- 실전 안전장치 (사이트·DB 에서는 바꿀 수 없다) ----
LIVE_TRADING_ENABLED=false
LIVE_MAX_ORDER_USDT=50
LIVE_MAX_DAILY_USDT=200
# 승인된 전략이 없을 때 실전 매수 후 걸어둘 손절 %
LIVE_DEFAULT_STOP_LOSS_PCT=3

# ---- 모의매매 ----
PAPER_FEE_RATE=0.001

# 사이트에 표시될 이 컴퓨터 이름 (선택)
WORKER_NAME=my-laptop
