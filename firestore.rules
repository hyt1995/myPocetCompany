rules_version = '2';

// 이 사이트는 로그인이 없으므로 브라우저(클라이언트 SDK)의 접근을 전부 막는다.
// 서버 API는 Admin SDK(서비스 계정)를 쓰기 때문에 이 규칙과 상관없이 읽고 쓸 수 있다.
// Firebase 콘솔 → Firestore Database → 규칙 탭에 이 내용을 붙여넣고 게시한다.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
